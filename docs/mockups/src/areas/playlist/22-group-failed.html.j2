{% from "parts/window.html.j2" import window, rail %}
{% from "parts/table.html.j2" import toolbar, heading, row, group %}
{% set screen_id = "playlist-group-failed" %}
{% set title = "Group with failed and cancelled videos" %}
{% set caption = "Failed and cancelled videos are counted separately, each with its own status icon." %}
{% set tickets = ["mg-019", "mg-146", "mg-233"] %}
{% call window(progress=62) %}
<div class="window-body">
  {{ rail("All", data.HOME_RAIL) }}
  <div class="content table-view">
    {{ toolbar() }}
    <div class="table" role="table">
      {{ heading() }}
      {{ row(data.DOWNLOADS[7]) }}
      {{ group(data.PLAYLIST_NAME, data.GROUP_MIXED) }}
      {{ row(data.DOWNLOADS[6]) }}
    </div>
  </div>
</div>
{% endcall %}
