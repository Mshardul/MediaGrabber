{% from "parts/window.html.j2" import window, rail %}
{% from "parts/home.html.j2" import link_card, choices_card, grab_view %}
{% set screen_id = "home-playlist" %}
{% set title = "Playlist link" %}
{% set caption = "The count shows and Grab says how many; the picker opens from it." %}
{% set tickets = ["mg-207", "mg-228"] %}
{% call window() %}
<div class="window-body">
  {{ rail("Grab", data.HOME_RAIL) }}
  <div class="content">
{% call grab_view(orb=false) %}
{{ link_card(data.PLAYLIST_LINK, result=data.PLAYLIST_RESULT) }}
{{ choices_card(data.VIDEO_CHOICE, "Grab all " ~ data.PLAYLIST_ITEMS|length) }}
{% endcall %}
  </div>
</div>
{% endcall %}
