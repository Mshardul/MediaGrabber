{# The oracle orb and its message. The orb is decoration; the message is what gets read. #}
{% from "parts/controls.html.j2" import button %}

{% macro orb_state(mood, view=none) -%}
{% if view %}
  {% set heading, message, action = data.EMPTY_VIEWS[view] %}
  {% set actions = (action,) %}
{% else %}
  {% set heading, message, actions = data.ORB_MESSAGES[mood] %}
{% endif %}
<div class="orb-state">
  <div class="orb" data-mood="{{ mood }}" aria-hidden="true"></div>
  <h3>{{ heading }}</h3>
  <p>{{ message }}</p>
  {% if actions %}
  <div class="orb-actions">{% for action in actions %}{{ button(action, "main" if loop.first else "standard") }}{% endfor %}</div>
  {% endif %}
</div>
{%- endmacro %}
