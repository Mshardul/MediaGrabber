{% extends "base.html.j2" %}
{% block content %}
<div class="doc-index">
  {% for slug, name in areas %}
  <section>
    <h2>{{ name }}</h2>
    {% if slug in built %}
    {% for part in built[slug] %}
    {% if built[slug]|length > 1 %}<h3>{{ part.name }}</h3>{% endif %}
    <ul>
      {% for screen in part.screens %}
      <li><a href="screens/{{ part.file }}#{{ screen.id }}">{{ screen.title }}</a></li>
      {% endfor %}
    </ul>
    {% endfor %}
    {% else %}
    <p class="doc-empty">Not built yet.</p>
    {% endif %}
  </section>
  {% endfor %}
</div>
{% endblock %}
