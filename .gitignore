# Tuist / Xcode generated — scoped to this leaf
*.xcodeproj
*.xcworkspace
Derived/
.build/
build/
*.xcuserstate
xcuserdata/

# Release artifacts — built in CI, never committed
*.dmg
/SHA256SUMS

# Sparkle EdDSA private key. The public key is TUIST_SPARKLE_PUBLIC_KEY.
.sparkle-private-key

# Bundled tools are fetched by scripts/fetch-tools.sh. They are not committed.
Resources/Tools/*
!Resources/Tools/.gitkeep
Resources/Shield/*
!Resources/Shield/.gitkeep
# License texts are written from the pinned sources by scripts/fetch-tools.sh.
Resources/Licenses/*
!Resources/Licenses/.gitkeep

# Python tooling
.venv/
.ruff_cache/
.pytest_cache/

# Playwright MCP captures
.playwright-mcp/
